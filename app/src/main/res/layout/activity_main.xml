<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <!-- Main ViewFlipper: 3 Pages in Infinite Loop -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- PAGE 0: Retro Minimalist Flip Clock -->
        <RelativeLayout
            android:id="@+id/pageClock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_black">

            <!-- Center Flip Clock Block -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Flip Cards Row: Hours : Minutes : Seconds -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="6dp">

                    <!-- Hour Card -->
                    <FrameLayout
                        android:id="@+id/flHourCard"
                        android:layout_width="100dp"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_flip_card">

                        <TextView
                            android:id="@+id/tvFlipHours"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="10"
                            android:textColor="#FFFFFF"
                            android:textSize="68sp"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false" />

                        <!-- Horizontal Split Seam -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_gravity="center"
                            android:background="#0D0D10" />
                    </FrameLayout>

                    <!-- Colon dots divider 1 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_colon"
                            android:layout_marginBottom="20dp" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_colon" />
                    </LinearLayout>

                    <!-- Minute Card -->
                    <FrameLayout
                        android:id="@+id/flMinuteCard"
                        android:layout_width="100dp"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_flip_card">

                        <TextView
                            android:id="@+id/tvFlipMinutes"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="42"
                            android:textColor="#FFFFFF"
                            android:textSize="68sp"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false" />

                        <!-- Horizontal Split Seam -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_gravity="center"
                            android:background="#0D0D10" />
                    </FrameLayout>

                    <!-- Colon dots divider 2 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_colon"
                            android:layout_marginBottom="20dp" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_colon" />
                    </LinearLayout>

                    <!-- Second Card -->
                    <FrameLayout
                        android:id="@+id/flSecondCard"
                        android:layout_width="100dp"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_flip_card">

                        <TextView
                            android:id="@+id/tvFlipSeconds"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="00"
                            android:textColor="#FFFFFF"
                            android:textSize="68sp"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false" />

                        <!-- Horizontal Split Seam -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_gravity="center"
                            android:background="#0D0D10" />
                    </FrameLayout>

                </LinearLayout>

                <!-- Date Label -->
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="THỨ TƯ • 18 THÁNG 11"
                    android:textColor="#888892"
                    android:textSize="14sp"
                    android:letterSpacing="0.18"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />

            </LinearLayout>

        </RelativeLayout>

        <!-- PAGE 1: English Learning (WebView) -->
        <RelativeLayout
            android:id="@+id/pageEnglish"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_black">

            <ProgressBar
                android:id="@+id/pbWebLoading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_alignParentTop="true"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:indeterminateOnly="true" />

            <WebView
                android:id="@+id/wvEnglish"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/pbWebLoading" />

            <!-- Floating reload button -->
            <Button
                android:id="@+id/btnReloadWeb"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#60000000"
                android:text="↻"
                android:textColor="#888888"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- PAGE 2: App Drawer -->
        <LinearLayout
            android:id="@+id/pageApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp">

            <!-- Search and Settings Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@color/card_bg"
                    android:hint="Tìm ứng dụng..."
                    android:textColorHint="@color/text_gray"
                    android:textColor="@color/text_white"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/card_bg"
                    android:text="⚙️"
                    android:textColor="@color/text_white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Apps Grid -->
            <GridView
                android:id="@+id/gvApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="4"
                android:verticalSpacing="16dp"
                android:horizontalSpacing="8dp"
                android:gravity="center" />
        </LinearLayout>

    </ViewFlipper>

</FrameLayout>
